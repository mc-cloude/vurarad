# On-prem bundle environment — copy to .env and edit.
# Used by docker compose -f deploy/onprem/docker-compose.yml.

# PostgreSQL metadata database
POSTGRES_PASSWORD=change-me

# MinIO object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Local OIDC (HS256 shared secret — for RS256, set OIDC_JWKS_PATH instead)
OIDC_HMAC_SECRET=change-me

# Host port for Caddy reverse proxy
HTTP_PORT=8080

# Audit bucket object-lock retention (days) — default ~7 years
AUDIT_RETENTION_DAYS=2555
